# Copy this file to ".env" and fill in ONE or BOTH options.
# .env is ignored by Git. Never commit real values: anyone with the webhook
# URL or bot token can post messages as your bot.

# Option A - Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Option B - Telegram: create a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
